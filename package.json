{
  "name": "sistema-automotivo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:db": "node scripts/testar-tudo.mjs --banco",
    "test:mapa": "node --test scripts/testar-ordenacao-mapa.mjs && node supabase/tests/validate-mapa-ui.mjs",
    "test:comissoes": "node scripts/testar-comissoes.mjs",
    "test:integracoes": "node supabase/tests/validate-webhook.mjs && node scripts/testar-backup.mjs",
    "preparar:funcoes": "node scripts/preparar-funcoes.mjs",
    "preview": "vite preview",
    "test:bancada": "node scripts/bancada.mjs",
    "test:documentos": "node --test scripts/testar-documentos.mjs",
    "test:entrega": "node --test scripts/testar-entrega-prometida.mjs && node supabase/tests/validate-mapa-ui.mjs",
    "test:oficina-agil": "node --test scripts/testar-oficina-agil.mjs",
    "test:site": "node scripts/testar-site.mjs",
    "test": "node scripts/testar-tudo.mjs",
    "test:unit": "node scripts/testar-tudo.mjs --unidade",
    "test:visual": "node scripts/verificar-estilo-operacional.mjs",
    "check": "node scripts/verificar-projeto.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "0.8.3",
    "jsbarcode": "3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}

{
  "name": "Automotivo - Lembretes e avisos aprovados",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Teste manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "agenda",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hzihxtjirttetnfdujcx.supabase.co/functions/v1/automacoes-oficina",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automotivo-secret",
              "value": "={{ $env.AUTOMOTIVO_AGENDADOR_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 55000
        }
      },
      "id": "processar",
      "name": "Gerar lembretes e processar avisos autorizados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        80
      ]
    }
  ],
  "connections": {
    "Teste manual": {
      "main": [
        [
          {
            "node": "Gerar lembretes e processar avisos autorizados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A cada 5 minutos": {
      "main": [
        [
          {
            "node": "Gerar lembretes e processar avisos autorizados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}